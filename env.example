# Supabase connection credentials
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini API Key (Server-side) - có thể cấu hình qua nút "Cài đặt API Key" trên giao diện
GEMINI_API_KEY=

# GitHub Storage for Candidate CVs (tùy chọn)
GITHUB_TOKEN=
GITHUB_REPO=ceohomes/CV-TQT
GITHUB_BRANCH=main
GITHUB_CV_FOLDER=cvs

# Chỉ cần đặt khi frontend (Cloudflare Pages) và backend (Render/Railway...) tách riêng.
# Trỏ tới domain backend, ví dụ: https://ten-app-cua-ban.onrender.com
VITE_API_BASE_URL=
