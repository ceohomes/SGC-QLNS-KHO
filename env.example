# Supabase connection credentials
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini API Key (Server-side) - có thể cấu hình qua nút "Cài đặt API Key" trên giao diện
GEMINI_API_KEY=

# GitHub Storage for Candidate CVs (tùy chọn)
GITHUB_TOKEN=
GITHUB_REPO=ceohomes/CV-TQT
GITHUB_BRANCH=main
GITHUB_CV_FOLDER=cvs

# Bật tính năng "Cài đặt API Key" trên giao diện (lưu key vào Supabase).
# SUPABASE_SERVICE_ROLE_KEY là secret CHỈ dùng ở server, không thêm tiền tố VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
